# Connection String para SQL Server
# Reemplaza los valores según tu servidor
# Ejemplo: Server=localhost;Initial Catalog=persist_db;User ID=sa;Password=YourPassword;TrustServerCertificate=true;Encrypt=false;

CONNECTION_STRING=Server=<YOUR_SERVER>;Initial Catalog=<YOUR_DATABASE>;User ID=<YOUR_USER>;Password=<YOUR_PASSWORD>;TrustServerCertificate=true;Encrypt=false;
